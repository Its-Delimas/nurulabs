{
  "name": "nurulabs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/export-data.mjs && node scripts/export-lab-index.mjs",
    "predev": "npm run data",
    "dev": "next dev",
    "prebuild": "npm run data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:labs": "npm run data && tsc src/lib/curriculum/labs/index.ts --outDir .labs-build --module commonjs --target es2020 --skipLibCheck && node -e \"require('fs').writeFileSync('.labs-build/labs.json', JSON.stringify(require('./.labs-build/labs/index.js').allLabs))\" && node scripts/validate-labs.mjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.11",
    "framer-motion": "^13.4.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
