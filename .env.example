# Accounts (optional). Without these, Nurulabs works as before and keeps
# progress only in the learner's browser. Find both in the Supabase dashboard:
# Project Settings -> API. The publishable (or legacy "anon") key is safe to
# expose to the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
